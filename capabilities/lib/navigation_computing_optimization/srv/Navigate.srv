# robonix/service/navigation/computing_optimization/navigate — start a vision-language navigation run.
#
# The service closes the loop itself: it reads RGB-D + pose from the camera and
# chassis primitives, asks cloud S2 for a semantic latent when the edge
# runtime decides one is needed, runs edge S1 to get discrete actions, and
# issues them as bounded chassis/move commands. Returns a run_id
# immediately; poll the status contract to track progress.
#
# A start that cannot be accepted — a run already active, the compute runtime
# unavailable, observations missing — fails the call rather than answering with
# a flag, so that an asynchronous caller polling this group gets a terminal
# failure instead of a run id that will never resolve.
string instruction     # required: natural-language route description, e.g.
                       # "walk down the hallway and stop at the kitchen door"
float32 timeout_s      # wall-clock ceiling for the whole run; 0 = use config.timeout_s
uint32 max_steps       # cap on control steps; 0 = use config.max_steps
---
bool accepted          # always true: a refusal arrives as a failed call, not as accepted=false
string run_id          # uuid handle, always set on a successful call. Pass to status/cancel/telemetry.
string message         # human-readable detail
