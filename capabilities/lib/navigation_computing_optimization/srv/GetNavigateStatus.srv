# robonix/service/navigation/computing_optimization/navigate/status — poll a navigation run.
#
# Empty run_id means "the run that is still active", so a caller running one
# navigation at a time does not have to track ids. It never resolves to a run
# that has already finished: reporting an earlier run's state as if it were this
# caller's is worse than reporting that nothing is active.
string run_id
---
bool known                    # false if no run with that id
string state                  # PENDING | RUNNING | SUCCEEDED | FAILED | CANCELED | TIMEOUT
                              # An unknown run reports FAILED, never PENDING: an id
                              # that is unknown now stays unknown, and PENDING would
                              # ask a polling caller to wait for it forever.
uint32 steps_executed         # control steps completed so far
uint32 actions_issued         # chassis/move commands issued so far
float32 elapsed_s
float32 mean_step_latency_ms  # rolling mean of per-step edge latency; 0 before the first step
bool stop_predicted           # true once the policy emitted the STOP action
string detail                 # human-readable
